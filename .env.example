# Environment Variables for Microservice

# ============================================
# Database & Cache
# ============================================
MONGODB_URI=mongodb://localhost:27017/social_microservice
MONGODB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ============================================
# Quiz Server Integration
# ============================================
QUIZ_SERVER_URL=http://localhost:3000
QUIZ_SERVER_INTERNAL_TOKEN=your-quiz-server-internal-token

# ============================================
# CORS & Network
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3000,http://localhost:5173
PORT=3001

# ============================================
# Firebase Cloud Messaging (NEW)
# ============================================
# Option 1: File path (simpler for development)
FIREBASE_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json

# Option 2: JSON inline (for production/Docker)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project",...}'

# Vapid key for web push notifications
FIREBASE_VAPID_PUBLIC_KEY=your_vapid_public_key_from_firebase_console

# ============================================
# Cross-Server Communication
# ============================================
# Internal token for communication between Quiz Server & Microservice
MICROSERVICE_INTERNAL_TOKEN=your-secret-internal-token-change-this-min-32-chars

# ============================================
# Google Drive (Optional)
# ============================================
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/callback
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# ============================================
# LiveKit (Video/Voice Calls)
# ============================================
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=60
RATE_LIMIT_MAX_API=100

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ============================================
# Environment
# ============================================
NODE_ENV=development
